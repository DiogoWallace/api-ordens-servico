# Copie para .env e ajuste os valores: cp .env.example .env
# O .env não é versionado.

# Porta da API no host.
API_PORT=3000

# Credenciais do PostgreSQL, usadas pelo banco e pela API.
POSTGRES_USER=ordens
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=ordens

# Nível de log da API: fatal, error, warn, info, debug, trace ou silent.
LOG_LEVEL=info

# Tempo de vida, em segundos, de uma ordem no cache de GET /ordens/:id.
CACHE_TTL_SEGUNDOS=60

# Fila de conclusões: tentativas por job e atraso base (ms) do backoff exponencial.
FILA_TENTATIVAS=3
FILA_ATRASO_MS=1000

# Demonstração: quantas tentativas de cada job o worker faz falhar de propósito (0 = nenhuma).
FILA_FALHAS_SIMULADAS=0
